# Normalize line endings so the repository stays portable across platforms.
* text=auto

*.java    text eol=lf
*.gradle  text eol=lf
*.properties text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.mcmeta  text eol=lf
*.md      text eol=lf
*.xml     text eol=lf
gradlew   text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.bat     text eol=crlf

*.png     binary
*.jar     binary
*.litematic binary
